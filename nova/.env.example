# ============================================================
# N.O.V.A — Business Development Agent. Copy to .env and fill in.
# (Windows: copy .env.example .env)
# The ONLY thing required to bring NOVA to life is an LLM key.
# Everything else is OPTIONAL and each feature stays dormant
# until its variables are set.
# ============================================================
NOVA_PORT=8788

# ---- Login (built-in signed-cookie auth) ----
AUTH_ENABLED=true
AUTH_USERNAME=admin
AUTH_PASSWORD=change-me
AUTH_SECRET=change-this-to-a-long-random-string
AUTH_TTL_HOURS=168

# ---- LLM (chat + command routing + writing outreach/reply/care copy) ----
# provider: groq | openai | anthropic | ollama | <any OpenAI-compatible>
# The LLM never invents prospect data — it only chats, routes, and writes copy
# over research it is handed.
LLM_PROVIDER=groq
LLM_MODEL=openai/gpt-oss-120b
LLM_API_KEY=
# LLM_BASE_URL=            # only for custom / OpenAI-compatible endpoints
# LLM_TEMPERATURE=0.4

# ---- Agency identity (injected into the copy the LLM writes) ----
NOVA_AGENCY_NAME=
NOVA_SENDER_NAME=
NOVA_SENDER_ROLE=Business Development
NOVA_NOTIFY_EMAIL=            # team alert inbox (HIGH-urgency replies, bookings)
NOVA_REPORT_BRAND=NOVA

# ---- SEO hook (Feature 1 Step 2 audit) — free Google Lighthouse ----
# Optional: a key only raises the rate limit; the data is identical.
PAGESPEED_API_KEY=

# ============================================================
# OUTBOUND EMAIL (nodemailer) — outreach, follow-ups, meeting
# confirmations, team alerts. Needed to SEND anything.
# ============================================================
SMTP_HOST=
SMTP_PORT=587                # 587 = STARTTLS, 465 = implicit TLS
SMTP_USER=
SMTP_PASS=
SMTP_FROM_NAME=NOVA
SMTP_FROM_EMAIL=             # defaults to SMTP_USER

# ============================================================
# INBOUND EMAIL (IMAP) — reply parsing (Feature 5).
# NOVA only processes replies whose sender domain matches a
# tracked prospect. Polling is non-destructive (does not mark
# your real inbox as read).
# ============================================================
IMAP_HOST=
IMAP_PORT=993
IMAP_USER=                   # defaults to SMTP_USER
IMAP_PASS=                   # defaults to SMTP_PASS
IMAP_TLS=true
IMAP_POLL_MINUTES=15         # ⚠ see README risk note re: provider rate limits

# ============================================================
# MEETING SCHEDULER (Feature 6)
# ============================================================
MEETING_AVAILABLE_DAYS=Monday,Tuesday,Wednesday,Thursday,Friday
MEETING_START_HOUR=10        # 10am
MEETING_END_HOUR=17          # 5pm
MEETING_DURATION_MINS=30
MEETING_TIMEZONE=Asia/Kolkata
MEETING_BUFFER_MINS=15
MEETING_GMEET_LINK=          # optional static Google Meet room link
# Google Calendar auth (optional — enables freebusy + real event creation).
# PREFERRED: the OAuth refresh flow below. NOVA mints a fresh access token on
# demand and caches it until just before expiry, so it never goes stale.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=        # obtained once via an OAuth consent (offline access)
# LEGACY: a single static access token (expires in ~1h — refresh flow is better).
GOOGLE_CALENDAR_TOKEN=

# ============================================================
# FOLLOW-UP SEQUENCES (Feature 4) — daily node-cron check.
# Drafts due follow-ups; never auto-sends (approval required).
# ============================================================
FOLLOWUP_ENABLED=true
FOLLOWUP_CRON=0 9 * * *      # 9am daily

# ============================================================
# CLIENT CARE (Feature 7) — daily node-cron check.
# ============================================================
CLIENTCARE_ENABLED=true
CLIENTCARE_CRON=0 8 * * *    # 8am daily
CLIENTCARE_CHECKIN_DAYS=30

# ============================================================
# WEB SCRAPE / CRAWLER (prospect research + lightweight audit)
# ============================================================
CRAWL_MAX_PAGES=40
CRAWL_CONCURRENCY=5
CRAWL_TIMEOUT_MS=15000
# CRAWL_UA=NOVAbot/1.0 (+https://example.com/nova)

# ---- PDF renderer (Full Prospect Report) — Python + Playwright ----
# NOVA_PYTHON=python          # or python3 on Linux/macOS
