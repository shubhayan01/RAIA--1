{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true,
    "types": ["node"]
  },
  "include": ["*.ts", "lib/**/*.ts", "llm/**/*.ts", "services/**/*.ts", "sources/**/*.ts", "report/**/*.ts"],
  "exclude": ["node_modules", "data"]
}
