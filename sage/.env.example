# ------------------------------------------------------------
# S.A.G.E — copy to .env and fill in.  (Windows: copy .env.example .env)
# The ONLY thing required to activate real intelligence is an LLM key.
# ------------------------------------------------------------
PORT=8787

# ---- Login (built-in signed-cookie auth) ----
AUTH_ENABLED=true
AUTH_USERNAME=admin
AUTH_PASSWORD=change-me
AUTH_SECRET=change-this-to-a-long-random-string
AUTH_TTL_HOURS=168

# ---- LLM (chat + command routing only; never invents SEO data) ----
# provider: groq | openai | anthropic | ollama | <any OpenAI-compatible>
LLM_PROVIDER=groq
LLM_MODEL=openai/gpt-oss-120b
LLM_API_KEY=
# LLM_BASE_URL=            # only for custom/OpenAI-compatible endpoints

# ---- SERP source ----
# google     = free live Google via Playwright browser (default)
# serpapi     = keyed, guaranteed SERP reports  (SERP_API_KEY)
# dataforseo  = keyed (SERP_API_KEY = base64 login:password)
# scrape      = legacy DuckDuckGo   |   none = disable SERP features
SERP_PROVIDER=google
SERP_API_KEY=
SERPER_API_KEY=            # optional: enables real AI Overview citations
SERP_HEADLESS=1           # 0 = show the browser (far less likely to be CAPTCHA'd; local only)
SERP_PROXY=               # optional residential proxy: http://user:pass@host:port
SERP_GL=us
SERP_HL=en

# ---- SEOptimer (real graded audit + backlinks + keyword rankings) ----
# When set, Audit and Ranks prefer SEOptimer (real data, no CAPTCHA).
# Key from the SEOptimer dashboard -> API panel. Roadmap: swap to DataForSEO later.
SEOPTIMER_API_KEY=
# SEOPTIMER_BASE_URL=https://api.seoptimer.com

# ---- Google data for the Intelligence report (all free) ----
PAGESPEED_API_KEY=
GOOGLE_ACCESS_TOKEN=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GSC_SITE_URL=
GA4_PROPERTY_ID=

# ---- Client report (downloadable proposal PDF) ----
REPORT_BRAND=S.A.G.E

# ---- Crawler ----
CRAWL_MAX_PAGES=120
CRAWL_CONCURRENCY=6
CRAWL_TIMEOUT_MS=15000

# ============================================================
# EXECUTION LAYER — turns SAGE from reporting into automation.
# All of the following are OPTIONAL; each feature stays dormant
# until its variables are set.
# ============================================================

# ---- WordPress CMS connector (Feature 1 + 3 + 5) ----
# Push approved briefs and title/meta fixes straight into WordPress.
# Create an Application Password: WP Admin -> Users -> Profile -> Application
# Passwords. Use THAT value here (never the account's login password).
WP_URL=                    # e.g. https://clientsite.com  (no trailing slash)
WP_USERNAME=
WP_APP_PASSWORD=

# ---- Shared SMTP (email transport for Features 2 + 4) ----
SMTP_HOST=
SMTP_PORT=587             # 587 = STARTTLS, 465 = implicit TLS
SMTP_USER=
SMTP_PASS=

# ---- Scheduled Intelligence Reports (Feature 2) ----
SCHEDULER_ENABLED=false
SCHEDULER_CRON=0 9 1 * *          # 9am on the 1st of each month
SCHEDULER_EMAIL_TO=               # comma-separated client recipients
SCHEDULER_EMAIL_FROM=             # defaults to SMTP_USER if blank

# ---- Ranking Drop Alert System (Feature 4) ----
ALERTS_ENABLED=false
ALERTS_EMAIL_FROM=                # defaults to SCHEDULER_EMAIL_FROM / SMTP_USER

# ---- Automated GSC Opportunity Loop (Feature 5) ----
OPPORTUNITY_MIN_IMPRESSIONS=100   # min GSC impressions for a striking-distance keyword
