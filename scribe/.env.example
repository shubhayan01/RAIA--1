# S.C.R.I.B.E — content-automation agent. Copy to .env for local dev.
# On Render these are set in the dashboard (see root render.yaml).

# Port (Render injects PORT automatically; local default 8789)
SCRIBE_PORT=8789

# ---- Auth ----
AUTH_ENABLED=true
AUTH_USERNAME=admin
AUTH_PASSWORD=change-me
AUTH_SECRET=change-me-to-a-long-random-string
AUTH_TTL_HOURS=12

# ---- LLM (chat + generation) ----
LLM_PROVIDER=groq
LLM_MODEL=openai/gpt-oss-120b
LLM_API_KEY=

# ---- Branding ----
SCRIBE_BRAND_NAME=SCRIBE

# ---- SERP / research ----
# tavily (key-based, recommended) | serpapi | dataforseo | google (free browser)
SERP_PROVIDER=tavily
TAVILY_API_KEY=
PAGESPEED_API_KEY=
CRAWL_TIMEOUT_MS=15000
